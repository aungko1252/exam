Book.cs

public class Book
{ 
    private int numPages;

    public Book()
    {
        numPages = 95;
    }

    public Book(int pages)
    {
        numPages = pages;
    }

    public int GetNumberPages()
    {
        return numPages;
    }
}

public class BigBook : Book
{
    public BigBook() : base(958) { }
}

Form1.cs

public Form1()
{
    InitializeComponent();
}

private void btnShowBooks_Click(object sender, EventArgs e)
{
    Book defaultBook = new Book();
    Book customBook = new Book(150);
    BigBook largeBook = new BigBook();

    MessageBox.Show($"Default Book Pages: {defaultBook.GetNumberPages()}", "Book Information");
    MessageBox.Show($"Custom Book Pages: {customBook.GetNumberPages()}", "Book Information");
    MessageBox.Show($"Big Book Pages: {largeBook.GetNumberPages()}", "Book Information");
}

