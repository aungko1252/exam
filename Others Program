Person.cs

class Person
{
    protected int age;

   
    public void Greet()
    {
        MessageBox.Show("Hello!");
    }

   
    public void SetAge(int age)
    {
        this.age = age;
    }
}

Student.cs

class Student : Person
{
    public void Study()
    {
        MessageBox.Show("I'm studying");
    }

    public void ShowAge()
    {
        MessageBox.Show($"My age is {age} years old.");
    }

}

Professor.cs

class Professor : Person
{
    public void Explain()
    {
        MessageBox.Show("I'm explaining");
    }
}

Form1.cs

public Form1()
{
    InitializeComponent();
}

private void btnPerson_Click(object sender, EventArgs e)
{
    Person person = new Person();
    person.Greet();
}

private void btnStudent_Click(object sender, EventArgs e)
{
    Student student = new Student();
    student.SetAge(20);
    student.Greet();
    student.ShowAge();
    student.Study();
}

private void btnProfessor_Click(object sender, EventArgs e)
{
    Professor professor = new Professor();
    professor.SetAge(45);
    professor.Greet();
    professor.Explain();
}

